from collections.abc import Iterator, Sequence
from datetime import datetime
from email.message import EmailMessage
from os import PathLike
from types import CapsuleType
from typing import Literal, Self, final, overload

type StrPath = str | PathLike[str]
type Compression = Literal['zstd', 'snappy', 'none']

class MboxTurboError(Exception): ...
class CorruptIndexError(MboxTurboError): ...
class StaleIndexError(MboxTurboError): ...

@final
class Address:
    @property
    def name(self) -> str | None: ...
    @property
    def email(self) -> str | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Attachment:
    @property
    def filename(self) -> str | None: ...
    @property
    def content_type(self) -> str | None: ...
    @property
    def data(self) -> bytes: ...

@final
class Message:
    @property
    def raw(self) -> bytes: ...
    @property
    def subject(self) -> str | None: ...
    @property
    def from_(self) -> list[Address]: ...
    @property
    def to(self) -> list[Address]: ...
    @property
    def cc(self) -> list[Address]: ...
    @property
    def date(self) -> datetime | None: ...
    @property
    def message_id(self) -> str | None: ...
    @property
    def text(self) -> list[str]: ...
    @property
    def html(self) -> list[str]: ...
    @property
    def attachments(self) -> list[Attachment]: ...
    def get(self, name: str) -> str | None: ...
    def get_all(self, name: str) -> list[str]: ...
    def to_email_message(self) -> EmailMessage: ...

@final
class Selection:
    @property
    def columns(self) -> list[str]: ...
    def __arrow_c_stream__(
        self, requested_schema: object | None = None
    ) -> CapsuleType: ...
    def to_parquet(self, path: StrPath, *, compression: Compression = 'zstd') -> int: ...

@final
class Mailbox:
    def __init__(self, path: StrPath, *, index: StrPath | None = None) -> None: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, key: int) -> Message: ...
    @overload
    def __getitem__(self, key: slice) -> list[Message]: ...
    def __iter__(self) -> Iterator[Message]: ...
    def batches(self, size: int) -> Iterator[list[Message]]: ...
    def select(
        self, columns: Sequence[str] | None = None, *, batch_size: int = 8192
    ) -> Selection: ...
    def save_index(self, path: StrPath) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc_info: object) -> None: ...
