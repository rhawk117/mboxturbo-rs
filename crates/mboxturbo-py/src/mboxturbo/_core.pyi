from collections.abc import Iterator, Sequence
from datetime import datetime
from email.message import EmailMessage
from os import PathLike
from types import CapsuleType
from typing import ClassVar, Literal, Self, final, overload

type StrPath = str | PathLike[str]
type Compression = Literal['zstd', 'snappy', 'none']

class MboxTurboError(Exception): ...
class CorruptIndexError(MboxTurboError): ...
class StaleIndexError(MboxTurboError): ...

@final
class Address:
    @property
    def name(self) -> str | None: ...
    @property
    def email(self) -> str | None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Attachment:
    @property
    def filename(self) -> str | None: ...
    @property
    def content_type(self) -> str | None: ...
    @property
    def data(self) -> bytes: ...

@final
class Message:
    @property
    def raw(self) -> bytes: ...
    @property
    def subject(self) -> str | None: ...
    @property
    def from_(self) -> list[Address]: ...
    @property
    def to(self) -> list[Address]: ...
    @property
    def cc(self) -> list[Address]: ...
    @property
    def date(self) -> datetime | None: ...
    @property
    def message_id(self) -> str | None: ...
    @property
    def text(self) -> list[str]: ...
    @property
    def html(self) -> list[str]: ...
    @property
    def attachments(self) -> list[Attachment]: ...
    def get(self, name: str) -> str | None: ...
    def get_all(self, name: str) -> list[str]: ...
    def to_email_message(self) -> EmailMessage: ...

@final
class Predicate:
    # Predicates are unhashable: they compare by their JSON form.
    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __and__(self, other: Predicate) -> Predicate: ...
    def __or__(self, other: Predicate) -> Predicate: ...
    def __invert__(self) -> Predicate: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    @staticmethod
    def from_json(json: str) -> Predicate: ...
    def to_json(self) -> str: ...

@final
class HeaderBuilder:
    def exists(self) -> Predicate: ...
    def equals(self, value: str | bytes) -> Predicate: ...
    def contains(self, value: str | bytes) -> Predicate: ...
    def startswith(self, value: str | bytes) -> Predicate: ...
    def matches(self, pattern: str | bytes) -> Predicate: ...

@final
class VerdictBuilder:
    def equals(self, result: str | bytes) -> Predicate: ...

def header(name: str) -> HeaderBuilder: ...
def verdict(method: str) -> VerdictBuilder: ...

@final
class Trust:
    def __init__(
        self,
        *,
        hosts: Sequence[str] = (),
        ip_ranges: Sequence[str] = (),
        authserv_ids: Sequence[str] = (),
        trust_idless_inside: bool = False,
    ) -> None: ...

@final
class Selection:
    @property
    def columns(self) -> list[str]: ...
    def __arrow_c_stream__(
        self, requested_schema: object | None = None
    ) -> CapsuleType: ...
    def to_parquet(
        self,
        path: StrPath,
        *,
        compression: Compression = 'zstd',
        overwrite: bool = False,
    ) -> int: ...

@final
class Mailbox:
    # Without `index`, the index is saved beside the mailbox as `<path>.mbxidx` and
    # reused while it matches; a directory that cannot be written leaves nothing behind
    # and the index stays in memory.
    def __init__(self, path: StrPath, *, index: StrPath | None = None) -> None: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, key: int) -> Message: ...
    @overload
    def __getitem__(self, key: slice) -> list[Message]: ...
    def __iter__(self) -> Iterator[Message]: ...
    def batches(self, size: int) -> Iterator[list[Message]]: ...
    # Column "raw" (each message's bytes) is opt-in: never part of the defaults.
    def select(
        self, columns: Sequence[str] | None = None, *, batch_size: int = 8192
    ) -> Selection: ...
    def save_index(self, path: StrPath) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc_info: object) -> None: ...
